# Copy to .env.local. Do not copy values from DAWG, Noochie, or other clients.
# St. Rita's Boxing needs its own Supabase project, Stripe account, and Resend sender.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (this product uses srb_ tables — see supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — St. Rita's own test keys first. Never commit live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — sending domain must be verified (SPF, DKIM, DMARC).
# Sign-in does not use Resend. Password reset, contact, and booking mail do.
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@hiresignalworks.com
RESEND_REPLY_TO=stritasboxing@gmail.com

# Contact form and booking alerts are delivered here.
OWNER_EMAIL=stritasboxing@gmail.com
STAFF_NOTIFICATION_EMAIL=

# Optional public contact email shown on the site (leave blank until confirmed).
NEXT_PUBLIC_CONTACT_EMAIL=
